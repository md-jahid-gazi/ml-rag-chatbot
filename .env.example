# Server Configuration
PROJECT_NAME="BRACU ML AI Knowledge Chatbot"
SECRET_KEY="replace-this-with-a-random-secret-key-for-jwt"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Retrieval & Grounding Settings
SIMILARITY_THRESHOLD=0.32
TOP_K_CHUNKS=4
CHUNK_SIZE=600
CHUNK_OVERLAP=100
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"

# Optional External LLM API Keys (defaults to local intelligent synthesis)
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Admin Default Credentials
ADMIN_EMAIL="admin@bracu.ac.bd"
ADMIN_PASSWORD="admin123"
